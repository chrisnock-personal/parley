# Copy to .env and fill in before `podman-compose up -d --build`

# Required: this host's routed/LAN IP -rtpengine binds media here so
# endpoints on other subnets can reach it.
RTPENGINE_PUBLIC_IP=192.168.1.X

# Optional: rtpengine's control address (default 127.0.0.1). Under WSL2's
# mirrored networking set it to 10.255.255.254: WSL drops UDP over 1472
# bytes sent to 127.0.0.1, which loses every browser call's SDP offer.
# RTPENGINE_NG_HOST=10.255.255.254

# Secrets: all required, no defaults. The stack refuses to start without
# them (or with the old example values). Generate each with
#   openssl rand -hex 24
# Controller auth (JWT_SECRET >= 32 chars, ADMIN_PASSWORD >= 12)
JWT_SECRET=
ADMIN_EMAIL=admin@intercom.local
ADMIN_PASSWORD=

# Controller DB (PGPASSWORD >= 16 chars)
PGDATABASE=intercom
PGUSER=intercom_user
PGPASSWORD=

# drachtio control-socket secret (pbx-core <-> its own drachtio, loopback)
DRACHTIO_SECRET=

# Bearer token between controller-backend, pbx-core (/status) and the
# transcriber (/talking, /poke) (>= 32 chars)
INTERNAL_API_TOKEN=

# CORS: leave unset. The console and client reach the API same-origin
# through nginx. Name an origin only if another site must call the API.
# CORS_ORIGIN=https://example.lan:8445

# Demo data -set SEED_DEMO=true for a ready-to-use demo: a broadcast crew on
# extensions 2001-2008 (all sharing DEMO_PASSWORD) and five talk groups.
# Additive and idempotent: never touches existing users or groups.
SEED_DEMO=false
DEMO_PASSWORD=demo1234

# Transcription -whisper.cpp whisper-server the transcriber sends audio to.
# Default: the shared instance on this host (127.0.0.1:8090).
WHISPER_URL=http://127.0.0.1:8090
